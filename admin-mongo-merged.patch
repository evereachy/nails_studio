+}
+
+/* ------------------------------ Мелочи ---------------------------------- */
+
+function Card({
+  title,
+  hint,
+  children,
+}: {
+  title: string;
+  hint?: string;
+  children: React.ReactNode;
+}) {
+  return (
+    <section className="rounded-card border border-line bg-elevated p-4">
+      <h2 className="text-[17px]">{title}</h2>
+      {hint && <p className="mb-4 mt-1 text-sm text-muted">{hint}</p>}
+      {!hint && <div className="mb-4" />}
+      {children}
+    </section>
